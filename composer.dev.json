{
    "name": "meridian/meridian",
    "description": "Self-hosted job scheduler: HTTP and shell jobs, users, roles and status pages.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "dragonmantank/cron-expression": "^3.4",
        "phpmailer/phpmailer": "^6.9",
        "symfony/console": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/routing": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Meridian\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Meridian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests/Release",
        "analyse": "phpstan analyse -c phpstan.neon --no-progress"
    }
}
