# Optional. Ohne diese Datei läuft alles mit Standardwerten.
# Als .env neben der compose.yaml speichern (nie committen).

# Erster Admin. Ohne Angabe: Benutzer "admin" mit zufälligem Passwort, einmalig im Log (docker compose logs web).
# MERIDIAN_ADMIN_USER=alex
# MERIDIAN_ADMIN_PASSWORD=mindestens-8-zeichen
# Das Passwort bleibt in der Umgebung des Containers sichtbar (docker inspect): nach dem ersten Start entfernen
# oder stattdessen MERIDIAN_ADMIN_PASSWORD_FILE mit dem Pfad zu einer Datei (z. B. Docker-Secret) verwenden.

# Port auf dem Host (Standard 8090)
# MERIDIAN_PORT=8090

# Version aus GitHub: Branch, Tag oder Commit (Standard: der Entwicklungs-Branch, später main)
# MERIDIAN_REPO_REF=main

# Betriebsart: prod (Standard). Anmeldung über HTTPS empfohlen (Secure-Cookie); über reines HTTP geht sie auch,
# mit dauerhafter Warnung in der Oberfläche. dev nur für die Entwicklung, nie im Betrieb.
# MERIDIAN_ENV=prod

# Reverse-Proxy (z. B. Nginx Proxy Manager): dessen IP oder Netz, damit die echte Client-IP gilt
# MERIDIAN_TRUSTED_PROXIES=172.19.0.0/16
# Wichtig hinter einem Proxy: ohne diese Angabe zählt die Sperre nach Fehlversuchen alle Clients als eine IP.
# Nur setzen, wenn Meridian ausschließlich über den Proxy erreichbar ist (sonst lässt sich X-Forwarded-For fälschen).
