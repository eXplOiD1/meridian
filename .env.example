# Optional. Ohne diese Datei läuft alles mit Standardwerten.
# Als .env neben der compose.yaml speichern (nie committen).

# Ersten Admin direkt in compose.yaml bzw. compose.build.yaml konfigurieren:
# MERIDIAN_ADMIN_USER und MERIDIAN_ADMIN_PASSWORD unter services.web.environment ersetzen.
# Diese Werte werden nicht aus .env übernommen. Anleitung: README.md.

# Port auf dem Host (Standard 8090)
# MERIDIAN_PORT=8090

# Für compose.build.yaml: Branch, Tag oder Commit (Standard main)
# MERIDIAN_REPO_REF=main

# Betriebsart: prod (Standard). Anmeldung über HTTPS empfohlen (Secure-Cookie); über reines HTTP geht sie auch,
# mit dauerhafter Warnung in der Oberfläche. dev nur für die Entwicklung, nie im Betrieb.
# MERIDIAN_ENV=prod

# Reverse-Proxy direkt in der Compose-Datei einstellen: MERIDIAN_TRUSTED_PROXIES.
# Standard: 172.19.0.0/16; an das tatsächliche Proxy-Netz anpassen, ohne Proxy leer setzen.
# Pflicht hinter einem Proxy: Kommt eine Anmeldung mit X-Forwarded-For oder Forwarded an und ist diese Angabe leer,
# lehnt Meridian sie ab (HTTP 503 mit Hinweis), weil die Sperre nach Fehlversuchen sonst nur die IP des Proxys sähe.
# X-Forwarded-For gilt nur von diesen Adressen; Meridian dann nur über den Proxy erreichbar machen.

# Registry-Images (compose.yaml; Standard latest aus main)
# MERIDIAN_IMAGE=ghcr.io/exploid1/meridian:latest
# MERIDIAN_SANDBOX_IMAGE=ghcr.io/exploid1/meridian-sandbox:latest
