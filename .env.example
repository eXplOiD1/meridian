# Optional values for either complete Compose file. / Optionale Werte für beide Compose-Dateien.
# Copy to .env beside the selected file; never commit real credentials.
# Als .env neben der gewählten Datei speichern; echte Zugangsdaten nie committen.

# Fresh installation only; existing accounts are preserved. / Nur Ersteinrichtung, bestehende Konten bleiben.
# Set MERIDIAN_ADMIN_PASSWORD directly in the Compose editor. / Direkt im Compose-Editor ersetzen.

# Published port / Veröffentlichter Port
# MERIDIAN_PORT=8090

# Application mode / Betriebsart
# MERIDIAN_ENV=prod

# HTTP concurrency (Docker default 2) / HTTP-Parallelität (Docker-Standard 2)
# MERIDIAN_HTTP_WORKERS=2

# Stable main images; use candidate, updater-candidate and host-candidate for beta.
# Stabile Main-Images; für Beta candidate, updater-candidate und host-candidate verwenden.
# MERIDIAN_IMAGE=ghcr.io/exploid1/meridian:latest
# MERIDIAN_UPDATER_IMAGE=ghcr.io/exploid1/meridian:updater-latest
# MERIDIAN_HOST_IMAGE=ghcr.io/exploid1/meridian:host-latest
# MERIDIAN_SANDBOX_IMAGE=ghcr.io/exploid1/meridian-sandbox:latest

# Optional sandbox / Optionale Sandbox
# COMPOSE_PROFILES=sandbox

# Docker socket group if different from root / Docker-Socket-Gruppe, falls nicht root
# MERIDIAN_DOCKER_GID=0

# Set MERIDIAN_TRUSTED_PROXIES directly in services.web.environment to the actual proxy network.
# MERIDIAN_TRUSTED_PROXIES unter services.web.environment auf das tatsächliche Proxy-Netz einstellen.
# Without a reverse proxy, use an empty string. / Ohne Reverse Proxy eine leere Zeichenkette verwenden.
