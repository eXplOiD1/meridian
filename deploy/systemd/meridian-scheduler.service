[Unit]
Description=Meridian Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meridian
Group=meridian
WorkingDirectory=/opt/meridian
EnvironmentFile=/etc/meridian/meridian.env
ExecStart=/usr/bin/php /opt/meridian/bin/meridian scheduler:run -v
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/meridian
# Der Planer plant nur: kein Schlüssel, kein Netz (Ausführung machen die Worker).
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
InaccessiblePaths=/run/meridian-docker /etc/meridian

[Install]
WantedBy=multi-user.target
