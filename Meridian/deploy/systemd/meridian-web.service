[Unit]
Description=Meridian Weboberfläche und API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meridian
Group=meridian
WorkingDirectory=/opt/meridian/Meridian
EnvironmentFile=/etc/meridian/meridian.env
ExecStart=/usr/local/bin/frankenphp php-server --root /opt/meridian/Meridian/public --listen :8080
Restart=on-failure
RestartSec=5

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/meridian
LoadCredential=meridian_key:/etc/meridian/master.key
Environment=MERIDIAN_KEY_FILE=%d/meridian_key

[Install]
WantedBy=multi-user.target
