{
    "name": "meridian/meridian",
    "description": "Self-hosted job scheduler: HTTP and shell jobs, users, roles and status pages.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "dragonmantank/cron-expression": "^3.4",
        "symfony/console": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/routing": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Meridian\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
